---
import { site } from '../site';
---

<section id="contact" class="contact" aria-label="Contact">
  <h2 class="display"><a href={`mailto:${site.email}`}>Get in Touch.</a></h2>
</section>

<style>
  .contact {
    padding: 10rem var(--gutter-end) 0 var(--hero-start);
  }

  h2 {
    font-size: 11.9vw;
  }

  a {
    text-underline-offset: 0.12em;
  }

  @media (min-width: 768px) {
    .contact {
      padding-top: 5.5rem;
    }

    h2 {
      font-size: calc(1rem + 3.6vw);
    }
  }
</style>

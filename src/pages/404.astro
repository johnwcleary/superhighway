---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="not found · superhighway" noindex>
  <Header />
  <main class="wrap">
    <h1 class="hero-line">404</h1>
    <p>This page doesn't exist. <a href="/">Back to superhighway</a>.</p>
  </main>
  <Footer />
</Base>

<style>
  main {
    padding-block: clamp(3rem, 12vw, 9rem) var(--space-section);
  }

  p {
    margin-top: 1.5rem;
  }
</style>
